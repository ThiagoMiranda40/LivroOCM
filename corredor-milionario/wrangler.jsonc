/**
 * Cloudflare Workers Static Assets Configuration
 * Projeto: O Corredor Milionário
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corredormilionario",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  }
}
